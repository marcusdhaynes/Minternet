{
  "name": "minternet",
  "productName": "Minternet",
  "private": true,
  "version": "0.1.0",
  "description": "A compact, security-conscious desktop browser prototype",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "check": "node --check src/main.cjs && node --check src/preload.cjs && node --check src/core/url.cjs && node --check src/core/tab-model.cjs && node --check ui/app.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.minternet.browser",
    "productName": "Minternet",
    "asar": true,
    "files": [
      "src/**/*",
      "ui/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "ui/minternet-brand.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "native/desktop/src-tauri/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "ui/minternet-brand.png",
      "target": [
        "AppImage"
      ],
      "category": "Network"
    },
    "compression": "maximum",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  }
}
