    "store": [
      "Encrypted cross-device normal tabs, groups, bookmarks, preferences, and undo history after client-side encryption and user authentication are verified",
      "Encrypted vault sync metadata only if end-to-end encryption and conflict resolution are validated"
    ],
    "avoid": [
      "Plaintext passwords, payment cards, secret bookmark URLs, private/Tor history, Gmail one-time codes, OAuth refresh tokens"
